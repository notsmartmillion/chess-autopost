# ======================================
# Chess Autopost - Environment Template
# Copy to .env and fill values
# ======================================

# -----------------------------
# Database (pick one)
# -----------------------------
# Local dev (no server needed):
DB_URL=sqlite:///./chessbot.db
# Or Postgres:
# DB_URL=postgresql+psycopg2://user:password@localhost:5432/chessbot

# -----------------------------
# Engine (Stockfish)
# -----------------------------
# Windows:
# STOCKFISH_PATH="C:\Program Files\Stockfish\stockfish.exe"
# Linux/macOS:
# STOCKFISH_PATH=/usr/local/bin/stockfish
STOCKFISH_PATH=/usr/local/bin/stockfish
ENGINE_THREADS=4
ENGINE_HASH_MB=1024
ENGINE_DEPTH=20
ENGINE_MULTIPV=4

# Analysis / Rendering helpers
ALT_PREVIEW_PLIES=2
ALT_MAX=2
MAX_SCENE_DURATION_MS=1600

# -----------------------------
# Caching
# -----------------------------
CACHE_DIR=./cache
ENABLE_DISK_CACHE=true

# -----------------------------
# Daily automation (flow.py)
# -----------------------------
# Comma-separated Lichess usernames to source daily games from (optional;
# sensible defaults are built in).
DAILY_LICHESS_PLAYERS=
# Optional Lichess API token (higher rate limits)
LICHESS_TOKEN=
# Lichess requires a descriptive User-Agent; a sensible default is built in
LICHESS_USER_AGENT=
# Chess.com asks for a descriptive User-Agent with contact info
CHESSCOM_USER_AGENT=
# TTS backend for build_video.py: local (pyttsx3) or silent
TTS_BACKEND=local
# Privacy for uploaded videos: public | unlisted | private
YOUTUBE_PRIVACY=unlisted
# Optional: LLM narration (falls back to built-in narrator if unset)
OPENAI_API_KEY=

# -----------------------------
# Local voice: Qwen3-TTS (Apache-2.0, runs on your GPU, no per-video cost)
# -----------------------------
# Set up once:  python services/orchestrator/voice_design.py --list
# Then set TTS_BACKEND=qwen (or leave it 'auto' — a set VOICE_REF_AUDIO wins).
VOICE_REF_AUDIO=
VOICE_REF_TEXT=
QWEN_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
QWEN_DEVICE=cuda:0
# flash_attention_2 is faster but often will not build on Windows; sdpa is safe.
QWEN_ATTN=sdpa
# Forced alignment for exact move cues (needs: pip install whisperx).
# With it off, word timings are estimated and pieces move approximately on cue.
QWEN_ALIGN=1

# -----------------------------
# ElevenLabs (Voice)
# -----------------------------
# With both of these set, TTS_BACKEND=auto uses ElevenLabs and gets
# word-level timestamps (so highlights land on the spoken word).
ELEVENLABS_API_KEY=
VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# mp3_44100_128 works on every tier; wav_44100 needs a paid tier.
ELEVENLABS_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.80
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEED=1.0

# -----------------------------
# Narration (optional LLM polish so it doesn't sound templated)
# -----------------------------
# Either key works; Anthropic is tried first. The whole script is written in a
# single request so the narration has continuity across the game.
ANTHROPIC_API_KEY=
# Default: claude-opus-4-8. claude-sonnet-5 is ~40% cheaper, claude-haiku-4-5 ~80%.
NARRATION_MODEL=
# Thinking depth: low | medium | high | xhigh | max  (default medium)
NARRATION_EFFORT=
CHANNEL_NAME=Quiet Chess

# -----------------------------
# Video description links (all optional — omitted from the description if blank)
# -----------------------------
# Your channel URL, used for the "more games like this" line
LINK_CHANNEL=
# Patreon / Ko-fi / Buy Me a Coffee
LINK_SUPPORT=
# Chess site signup. If this is an AFFILIATE link you MUST also set
# AFFILIATE_DISCLOSURE below - disclosure is an FTC requirement, not optional,
# and YouTube separately requires ticking "contains paid promotion".
LINK_PLAY_CHESS=
AFFILIATE_DISCLOSURE=Some links above are affiliate links. If you sign up through them the channel earns a commission at no extra cost to you.
CONTACT_EMAIL=

# -----------------------------
# Game source
# -----------------------------
# classics = famous world-champion games (default), lichess = recent online play
DAILY_SOURCE=classics
# Restrict the classics pool, e.g. Tal,Fischer,Kasparov
DAILY_LEGENDS=

# -----------------------------
# YouTube API (Uploader)
# -----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# -----------------------------
# Optional Services
# -----------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SLACK_WEBHOOK_URL=

# -----------------------------
# Logging
# -----------------------------
LOG_LEVEL=INFO

# -----------------------------
# Paths
# -----------------------------
OUTPUT_DIR=./outputs
AUDIO_DIR=./outputs/audio
