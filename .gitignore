# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
.python-version
.pytype/
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Virtual env
.venv/
venv/
ENV/

# Node / TypeScript
node_modules/
apps/renderer/node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build / Dist
build/
dist/
.cache/
apps/renderer/.cache/

# Environment files
.env
.env.*
!.env.example

# Outputs — disposable build artifacts. NOTE: durable state deliberately lives
# in state/ (tracked), not here, so clearing outputs/ can never cause the
# channel to re-publish a game it has already posted.
outputs/

# Media outputs
*.mp4
*.wav
*.mp3
out/
apps/renderer/out/

# Keep committed art assets (piece sprites, portraits) — they are inputs,
# not generated media.
*.png
*.jpg
*.jpeg
*.gif
!apps/renderer/public/pieces/**
!apps/renderer/public/portraits/**

# OS files
.DS_Store
Thumbs.db

# Editors / IDE
.idea/
.vscode/*
!.vscode/settings.json

# Archived renders are large and regenerable; the ledger in state/ records them.
outputs/videos/

# Engine cache and the downloaded Stockfish binary
cache/
tools/stockfish/

# Renderer build artifacts (regenerated by build_video.py)
apps/renderer/public/script.json
apps/renderer/public/audio/
apps/renderer/public/timeline.json
apps/renderer/public/audio_durations.json
