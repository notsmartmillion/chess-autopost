{
  "name": "chess-autopost-renderer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "remotion studio src/index.tsx",
    "render": "remotion render src/index.tsx ChessVideo --codec=h264 --crf=18 --overwrite --output=out/video.mp4",
    "render:thumb": "remotion still src/index.tsx Thumbnail out/thumbnail.png --frame=12 --overwrite",
    "build": "tsc --noEmit",
    "fetch-pieces": "node scripts/fetch-pieces.mjs"
  },
  "dependencies": {
    "chess.js": "^1.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "remotion": "4.0.347"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.347",
    "@types/react": "18.2.61",
    "@types/react-dom": "18.2.19",
    "typescript": "5.5.4"
  }
}
